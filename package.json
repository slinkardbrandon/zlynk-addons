{
  "name": "zlynk-addons",
  "private": true,
  "description": "Monorepo for Zlynk WoW addons",
  "scripts": {
    "dev": "pnpm link:addons && pnpm libs",
    "link:addons": "bash scripts/link.sh",
    "libs": "bash scripts/fetch-libs.sh",
    "lint": "turbo run lint",
    "format": "stylua addons/ packages/",
    "build": "turbo run build",
    "gates": "pnpm lint && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@10.33.0"
}
